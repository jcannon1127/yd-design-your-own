# Production / VPS (`npm start`): listen on this high port. Default is 3040.
# Caddy reverse-proxies dyo.thisisus.ai → 127.0.0.1:3040. Never set 80 or 443.
PORT=3040

# Bind address. 127.0.0.1 for a native process behind Caddy; 0.0.0.0 for Docker.
HOST=0.0.0.0

# Local `npm run dev` / `npm run dev:api` force PORT=3001 so Vite's /api proxy matches.

# OPTIONAL: AI mockup provider. If unset, the AI mockup endpoint returns the
# input print swatch as a placeholder. Plug your provider key here when ready.
# Supported: OPENAI_API_KEY (uses gpt-image-1). Leave blank to disable.
OPENAI_API_KEY=
